# Supabase (Server-side only; never expose service role key to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sarvam AI (Verify model IDs in https://docs.sarvam.ai)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v4-flash

# Flagsmith (Server-side environment key)
FLAGSMITH_SERVER_KEY=

# NudgeBee (Workflow webhook URL carries token — server-side only)
NUDGEBEE_WEBHOOK_URL=
CALLBACK_SECRET=replace-with-strong-random-secret
PUBLIC_BASE_URL=http://localhost:3000

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Optional dev/local flags (MUST be false in production)
ENABLE_DEV_CALLBACK=false
ENABLE_DEMO_MEMORY_DB=false
